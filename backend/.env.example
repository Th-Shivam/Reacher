CLERK_SECRET_KEY=

MONGODB_URL=
MONGODB_DATABASE=

# Appwrite Storage Config
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# Public backend origin used in links included in outreach emails.
# Upload requests provide a fallback automatically, but set this for old resumes.
PUBLIC_API_URL=http://localhost:8000

# AI Provider Config
GEMINI_API_KEY=

# Runtime environment and explicit browser origins.
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=https://reacherpro.vercel.app

# Outreach abuse controls (shared through MongoDB).
OUTREACH_RATE_LIMIT_PER_HOUR=10
OUTREACH_DAILY_QUOTA=20
OUTREACH_CONCURRENCY_LIMIT=1
OUTREACH_LOCK_TTL_SECONDS=1800

# Bounded pipeline and external API execution.
MAX_LLM_CALLS_PER_PIPELINE=4
MAX_WEB_SEARCHES_PER_RESEARCH=2
PIPELINE_STEP_TIMEOUT_SECONDS=90
PIPELINE_MAX_EXECUTION_SECONDS=300
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4096
WEB_SEARCH_TIMEOUT_SECONDS=15
EXTERNAL_API_TIMEOUT_SECONDS=30
MAX_EMAIL_SUBJECT_CHARACTERS=300
MAX_EMAIL_BODY_CHARACTERS=10000

# Resume upload limits. Request size includes multipart overhead.
MAX_RESUME_SIZE_BYTES=5242880
MAX_RESUME_REQUEST_SIZE_BYTES=6291456
